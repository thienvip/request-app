@model src.Web.Common.Models.RequestModels.ListRequestViewModel

<style>
    label {
        font-weight: normal !important;
    }

    /* TextArena */
    #holder {
        background-color: white;
        border: 1px solid #ccc;
        margin-left: 8px;
        margin-right: 8px;
    }

    textarea {
        border: none !important;
        resize: none;
    }

    textarea:focus {
        outline: none;
    }
</style>

@{
    var attachments = Model.ChangeRequest.FirstOrDefault()?.ChangeRequestAttachment;
    var initialPreview = attachments?.Select(attachment => attachment.FilePath);
}

<form id="frmHandBookConfirm" asp-controller="Request" asp-action="Submit" class="form-horizontal" method="post"
      role="form">
    <div class="box box-solid">   
        <div class="box-body">
            <h3 class="text-center text-blue">
                @SharedLocalizer["label_request"]<br>
            </h3>
            <div class="box box-success box-solid">
                <div class="box-header">
                    <h5 class="box-title">
                        VAS - @SharedLocalizer["label_brand"]
                    </h5>
                </div>

                <div class="box-body ">
                    <p class="well well-sm bg-blue text-bold" style="margin-top: 10px;">
                        @SharedLocalizer["label_general_info"]
                    </p>
                    <div>
                        <div style="display:flex; align-items:center; justify-content:space-between">
                            <p style="padding-top: 5px;" class="text-yellow">
                                @SharedLocalizer["label_ask_change"]
                            </p>
                        </div>
                        <div class="row">
                            <div class="col-sm-12 " style=" margin:auto">
                                <div class="box-body">
                                    <label class="control-label col-sm-2" style="text-align:left;">@SharedLocalizer["label_system"]: <span class="field-required">*</span></label>
                                    <div class="col-sm-10">

                                        @if (string.IsNullOrWhiteSpace(Model.ChangeRequest.FirstOrDefault().ApplicationOtherName))
                                        {
                                            <select class="form-control select2 " asp-for="@Model.ChangeRequest.FirstOrDefault().ApplicationId" style="width: 100%;" id="options" onchange="handleOptionChange()">
                                                <option value="AD        " selected="selected">Admission</option>
                                                <option value="FI        ">Finance</option>
                                                <option value="HR        ">HR</option>
                                                <option value="Ne        ">Network</option>
                                                <option value="SI        ">SISMS</option>
                                                <option value="Sy        ">System</option>
                                                <option value="">Others</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <input type="text"  value="@Model.ChangeRequest.FirstOrDefault().ApplicationOtherName" id="replacementInput" class="form-control" style="width: 100%;" placeholder="Enter text">
                                        }
                              
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="row">
                            <div class="col-sm-6 " style="margin:auto">
                                <div class="box-body">
                                    <label class="control-label col-sm-4" style="text-align:left;">@SharedLocalizer["label_requester"]: <span class="field-required">*</span></label>
                                    <div class="col-sm-8">
                                        <input type="text" asp-for="@Model.ChangeRequest.FirstOrDefault().Requester" class="form-control" maxlength="100" required style="margin-left:7px">
                                        <span asp-validation-for="@Model.ChangeRequest.FirstOrDefault().Requester" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 " style="margin:auto">
                                <div class="box-body">
                                    <label class="control-label col-sm-4" style="text-align:left;">@SharedLocalizer["label_department"]: <span class="field-required">*</span></label>
                                    <div class="col-sm-8">
                                        <input asp-for="@Model.ChangeRequest.FirstOrDefault().Campus" type="text" class="form-control" maxlength="100" required>
                                        <span asp-validation-for="@Model.ChangeRequest.FirstOrDefault().Campus" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12 " style=" margin:auto">
                                <div class="box-body">
                                    <label class="control-label col-sm-2" style="text-align:left;">@SharedLocalizer["label_change_type"]: <span class="field-required">*</span></label>
                                    <div class="col-sm-10">
                                        @if (string.IsNullOrWhiteSpace(Model.ChangeRequest.FirstOrDefault().ChangeRequestOtherName))
                                        {
                                            <select class="form-control select2 " asp-for="@Model.ChangeRequest.FirstOrDefault().ChangeRequestTypeId" style="width: 100%;" id="optionsType">
                                                <option value="RC" selected="selected">@SharedLocalizer["label_opt_change_type_1"]</option>
                                                <option value="NR">@SharedLocalizer["label_opt_change_type_2"]</option>
                                                <option value="CD">@SharedLocalizer["label_opt_change_type_3"]</option>
                                                <option value="">@SharedLocalizer["label_opt_change_type_4"]</option>
                                            </select>
                                        }else
                                        {
                                            <input type="text" asp-for="@Model.ChangeRequest.FirstOrDefault().ChangeRequestOtherName" id="replacementInputType" class="form-control " style="width: 100%; " placeholder="Enter text" >
                                        }                              
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12" style=" margin:auto">
                                <div class="box-body">
                                    <label class="control-label col-sm-2" style="text-align:left;">@SharedLocalizer["label_priority"]: <span class="field-required">*</span></label>
                                    <div class="col-sm-10">                                   
                                        <select class="form-control select2 " asp-for="@Model.ChangeRequest.FirstOrDefault().PriorityId" style="width: 100%;" id="optionsPriority" onchange="handleOptionChangePriority()">
                                            <option value="EM" selected="selected">@SharedLocalizer["label_opt_priority_1"]</option>
                                            <option value="RO">@SharedLocalizer["label_opt_priority_2"]</option>
                                            <option value="UR">@SharedLocalizer["label_opt_priority_3"]</option>
                                            <option value="">@SharedLocalizer["label_opt_priority_4"]</option>
                                        </select>                                                                   
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (@Model.ChangeRequest.FirstOrDefault()?.PriorityExpectedDate != null)
                        {
                            <div class="row">
                                <div class="col-sm-12 " style="margin:auto">
                                    <div class="box-body">
                                        <label class="control-label col-sm-2" style="text-align:left;">@SharedLocalizer["label_expected_date"]:</label>
                                        <div class="col-sm-10">
                                            <input asp-for="@Model.ChangeRequest.FirstOrDefault().PriorityExpectedDate" type="date" class="form-control" maxlength="100" disabled>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        }

                    </div>
                    <br />
                    <p class="well well-sm bg-blue text-bold" >
                        @SharedLocalizer["label_change_des"]
                    </p>
                    <div>
                        <div style="display:flex; align-items:center; justify-content:space-between">
                            <label>
                                @SharedLocalizer["label_change_content"]:
                            </label>
                        </div>
                        <fieldset id='holder'>
                            <textarea rows="8" maxlength="250" disabled class="form-control" id="currentFeature" placeholder="Enter current feature ..."></textarea>
                            <textarea rows="8" maxlength="250" disabled class="form-control" id="featureRequiringModification" placeholder="Enter feature requiring modification ..."></textarea>
                        </fieldset>
                    </div>

                    @if(Model.ChangeRequest.FirstOrDefault().ChangeRequestAttachment.Count() > 0)
                    {                       
                        <div class="row">
                            <div class="box-body">
                                <div class="col-md-12">
                                    <div class="box">
                                        <div class="box-header with-border">
                                            <h3 class="box-title" style="font-size:13px; font-weight:bold">Attachments</h3>
                                            <div class="box-tools pull-right">
                                                <button type="button" class="btn btn-box-tool" data-widget="collapse">
                                                    <i class="fa fa-minus"></i>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="box-body">
                                            <div class="row">
                                                <div class="col-md-12" style=" margin:auto">
                                                    <div class="box-body">
                                                        <div class="pull-right">
                                                            <input id="file-fr" name="file-fr[]" type="file" multiple>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>                                
                                    </div>
                                </div>
                            </div>
                        </div>
                    }                
                    <p class="well well-sm bg-blue text-bold" style="margin-top: 10px;">
                        @SharedLocalizer["label_confirm_req"]
                    </p>
                    <div class="row">
                        <div class="col-sm-12 " style=" margin:auto">
                            <div class="box-body">
                                <label class="control-label col-sm-2" style="text-align:left;">@SharedLocalizer["label_by_sup"]: <span class="field-required">*</span></label>
                                <div class="col-sm-10">
                                    <select class="form-control select2 " asp-for="@Model.ChangeRequest.FirstOrDefault().ChangeRequestFlow.NextStateUserInCharge" value="@Model.ChangeRequest.FirstOrDefault().ChangeRequestFlow.NextStateUserInCharge" style="width: 100%;" id="options" onchange="handleOptionChange()">
                                        @foreach (var user in Model.ListUsers)
                                        {
                                            <option value="@user.Id">@user.UserName</option>
                                        }

                                    </select>
                                </div>
                            </div>
                        </div>                      
                    </div>                 
                </div>


            </div>
            <hr />

            <div id="btn_confirm_area">
                <div class="col-md-12 text-center">
                    <button type="submit" id="Process" class="btn btn-success btnClickedEvent">
                        <i class="fa fa-arrow-circle-o-right "></i>
                        @SharedLocalizer["btn_accept"]
                    </button>
                    <a class="btn btn-default" id="cancel">
                        <i class="fa fa-times-circle"></i> @SharedLocalizer["btn_cancel"]
                    </a>
                </div>
            </div>
        </div>
        
          
    </div>
</form>

<script type="text/javascript">
    $('form *').prop('disabled', true);

    // Add values to the textareas
    var currentFeatureValue = "Current feature:" + ' @Model.ChangeRequest.FirstOrDefault().CurrentFeature';
    var featureRequiringModificationValue = "Feature requiring modification:" + ' @Model.ChangeRequest.FirstOrDefault().FeatureRequiringModification';

    document.getElementById('currentFeature').value = currentFeatureValue;
    document.getElementById('featureRequiringModification').value = featureRequiringModificationValue;

    var initialPreviewArray = @Html.Raw(Json.Serialize(initialPreview ?? Enumerable.Empty<string>()));

    $('#file-fr').fileinput({
        theme: 'fa5',
        language: 'fr',
        uploadUrl: '#',
        allowedFileExtensions: ['jpg', 'png', 'jpeg'],
        previewFileIcon: "<i class='glyphicon glyphicon-king'></i>",
        overwriteInitial: false,
        initialPreviewAsData: true,
        initialPreview: initialPreviewArray
    });
</script>